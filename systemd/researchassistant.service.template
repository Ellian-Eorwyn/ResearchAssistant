[Unit]
Description=ResearchAssistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__RA_USER__
Group=__RA_GROUP__
WorkingDirectory=__RA_ROOT__
Environment=RA_HOST=0.0.0.0
Environment=RA_PORT=7995
Environment=RA_OPEN_BROWSER=0
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/default/researchassistant
ExecStart=__RA_PYTHON__ __RA_ROOT__/run.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
