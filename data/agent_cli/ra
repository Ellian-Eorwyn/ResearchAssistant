def cmd_version(args, token):
    body, _ = request("GET", "/api/workflow/v1/version", token=token, timeout=15)
    data = data_of(body)
    return True, f"ra contract {CLI_CONTRACT_VERSION}, server contract {data.get('contract_version')}.", ["ra doctor"], data, []


def cmd_doctor(args, token):
    check_contract(token)
    body, _ = request(
        "GET", "/api/workflow/v1/preflight", token=token,
        params={"refresh_capabilities": "true" if args.refresh_capabilities else None},
    )
    data = data_of(body, allow_error=True)
    problems = [
        {"code": c["id"], "message": c["detail"], "remedy": c.get("remedy", "")}
        for c in data.get("checks", [])
        if not c.get("ok") and c.get("severity") != "info"
    ]
    lines = [data.get("summary", "")]
    lines.append(f"  fetch: {'ready' if data.get('ok_to_fetch') else 'BLOCKED'}")
    lines.append(f"  columns: {'ready' if data.get('ok_to_run_columns') else 'BLOCKED'}")
    return bool(data.get("ok_to_fetch")), "\n".join(lines), data.get("next"), data, problems


def cmd_where(args, token):
    check_contract(token)
    body, _ = request("GET", "/api/workflow/v1/orientation", token=token)
    data = data_of(body)
    lines = [data.get("summary", "")]
    for column in data.get("columns", [])[:20]:
        if column.get("has_prompt"):
            lines.append(
                f"  {column['id']}  {column['label'][:44]:46} {column.get('filled_rows', 0)} filled"
            )
    return True, "\n".join(lines), data.get("next_actions"), data, []


def cmd_plan_sheet(args, token):
    check_contract(token)
    path = Path(args.path).expanduser()
    if not path.is_absolute():
        path = (Path.cwd() / path).resolve()
    body, _ = request(
        "POST", "/api/workflow/v1/sheet/parse", token=token,
        payload={
            "path": str(path),
            "header_row": args.header_row,
            "prompts_row": args.prompts_row,
            "no_prompts_row": args.no_prompts_row,
            "repair_encoding": args.repair_encoding,
        },
    )
    data = data_of(body)

    repo_root = find_repo_root()
    if repo_root:
        out = repo_root / ".ra_repo" / "workflow"
        out.mkdir(parents=True, exist_ok=True)
        (out / "sheet_plan.json").write_text(json.dumps(data, ensure_ascii=False, indent=2), encoding="utf-8")

    problems = [
        {"code": a["code"], "message": a["message"], "remedy": ""}
        for a in data.get("anomalies", [])
    ]
    blocking = {
        "no_header_row_found", "no_url_column_found", "no_sources_found", "mojibake_unrepairable",
    }
    ok = not any(a["code"] in blocking for a in data.get("anomalies", []))
    nxt = ["ra create-sources", "ra create-columns"] if ok else ["Fix the sheet, then run ra plan-sheet again"]
    return ok, data.get("summary", ""), nxt, data, problems


def _stored_plan():
    repo_root = find_repo_root()
    if not repo_root:
        raise Problem("Not inside a repository.", code="no_repository", exit_code=EXIT_USAGE)
    path = repo_root / ".ra_repo" / "workflow" / "sheet_plan.json"
    if not path.is_file():
        raise Problem(
            "No parsed spreadsheet found.",
            code="no_sheet_plan",
            remedy="ra plan-sheet <spreadsheet>",
            exit_code=EXIT_USAGE,
        )
    return json.loads(path.read_text(encoding="utf-8"))


MAX_SHOWN_CHANGES = 12


def _operation(command, operation, params, apply, token):
    body, _ = request(
        "POST", f"/api/workflow/v1/operations/{operation}", token=token,
        payload={"params": params, "apply": apply},
    )
    data = data_of(body, allow_error=True)
    plan = data.get("plan") or {}
    problems = [
        {"code": b["code"], "message": b["message"], "remedy": ""} for b in plan.get("blockers", [])
    ]
    ok = not problems

    # A dry run whose consequences are only in the JSON is not a review. The
    # `detail` line is where an operation says what it worked out -- the values
    # it read out of a prompt, for instance -- and the user has to see it before
    # agreeing to `--apply`.
    lines = [data.get("summary", "")]
    changes = plan.get("changes") or []
    if changes and not apply:
        for change in changes[:MAX_SHOWN_CHANGES]:
            detail = change.get("detail") or change.get("after") or ""
            lines.append(f"  {change.get('subject', '')}  {detail}")
        if len(changes) > MAX_SHOWN_CHANGES:
            lines.append(f"  ... and {len(changes) - MAX_SHOWN_CHANGES} more")
    for warning in (plan.get("warnings") or [])[:MAX_SHOWN_CHANGES]:
        lines.append(f"  - {warning.get('code', '')}: {warning.get('message', '')}")

    nxt = data.get("next") or []
    if ok and not apply:
        nxt = [{
            "command": f"ra {command} --apply",
            "gate": "ask_user",
            "why": f"Show the user these {len(changes)} change(s) and get their agreement first.",
        }]
    return ok, "\n".join(line for line in lines if line), nxt, data, problems


def cmd_create_sources(args, token):
    check_contract(token)
    params = _stored_plan()["create_sources_params"]
    return _operation("create-sources", "create_sources", params, args.apply, token)


def cmd_create_columns(args, token):
    check_contract(token)
    params = _stored_plan()["create_columns_params"]
    return _operation("create-columns", "create_columns", params, args.apply, token)


def cmd_set_constraints(args, token):
    check_contract(token)
    ids = [i.strip() for i in (args.ids or "").split(",") if i.strip()]
    params = {"column_ids": ids, "overwrite_existing": args.overwrite}
    return _operation("set-constraints", "set_column_constraints", params, args.apply, token)


def cmd_columns(args, token):
    check_contract(token)
    body, _ = request("GET", "/api/workflow/v1/orientation", token=token)
    data = data_of(body)
    columns = data.get("columns", [])
    lines = [f"{len(columns)} column(s):"]
    for column in columns:
        if not column.get("has_prompt"):
            continue
        lines.append(
            f"  {column['id']}  {column['label'][:44]:46} "
            f"{column.get('filled_rows', 0)} filled / {column.get('empty_rows', 0)} empty"
        )
    # Same preference as `ra where`: a column whose prompt lists exact answers
    # shows a misread prompt after one run instead of after all of them.
    prompted = [c for c in columns if c.get("has_prompt") and not c.get("filled_rows")]
    first = next((c for c in prompted if c.get("allowed_values")), prompted[0] if prompted else None)
    nxt = [f"ra run-column {first['id']} --wait"] if first else ["ra create-columns"]
    return True, "\n".join(lines), nxt, {"columns": columns}, []


def cmd_fetch(args, token):
    check_contract(token)
    ids = [i.strip() for i in (args.ids or "").split(",") if i.strip()]
    body, _ = request(
        "POST", "/api/workflow/v1/runs/source-phases", token=token,
        payload={
            "phases": args.phases.split(","),
            "scope": args.scope,
            "source_ids": ids,
            "force": args.force,
            "limit": args.limit,
            "wait_seconds": 120 if args.wait else 0,
        },
    )
    raise_if_busy(body, token)
    data = data_of(body)
    if args.wait and not data.get("terminal") and data.get("run_id"):
        data = follow(data["run_id"], token) or data
    ok = not data.get("counts", {}).get("failed")
    return ok, data.get("summary", ""), data.get("next"), data, []


def cmd_convert(args, token):
    args.phases, args.scope, args.limit = "convert", "all", None
    return cmd_fetch(args, token)


def cmd_triage(args, token):
    check_contract(token)
    body, _ = request("GET", "/api/workflow/v1/triage", token=token, params={"phase": args.phase})
    data = data_of(body)
    lines = [data.get("summary", "")]
    for group in data.get("groups", []):
        label = group["error_code"] + (f" / {group['detail_pattern']}" if group.get("detail_pattern") else "")
        lines.append(f"\n[{label}]  x{group['count']}  ({group['classification']})")
        lines.append(f"  {group['explanation']}")
        for example in group.get("examples", [])[:3]:
            lines.append(f"    {example['id']}  {example['url'][:66]}")
        if group.get("remedy_command"):
            lines.append(f"  -> {group['remedy_command']}")
    return not data.get("total_failed"), "\n".join(lines), data.get("next"), data, []


def cmd_retry(args, token):
    check_contract(token)
    body, _ = request("GET", "/api/workflow/v1/triage", token=token, params={"phase": "fetch"})
    triage = data_of(body)
    ids = [
        source_id
        for group in triage.get("groups", [])
        if group.get("classification", "").startswith("retryable")
        for source_id in group.get("source_ids", [])
    ]
    if not ids:
        return True, "Nothing worth retrying.", ["ra triage"], {"source_ids": []}, []

    args.ids, args.phases, args.scope = ",".join(ids), "fetch,convert", "all"
    args.force, args.limit = False, None
    return cmd_fetch(args, token)


def _attach_remedies(blockers, *, role: str = "", source_id: str = ""):
    """Turn attach blockers into commands that can actually be run.

    `--role` and `--overwrite` apply to every path in one invocation, so a batch
    of mixed file types cannot succeed in a single call no matter what flags it
    gets. Left to itself the caller sees the blockers, no remedy, and "fix the
    blockers" -- the dead end this tool exists to remove. So group the offending
    files by what they need and hand back one command per group.

    An explicit `--role` or `--source-id` is carried through untouched. Guessing
    a role from the extension is only ever a fallback: a `.pdf` is the rendered
    copy of a page saved as HTML, but it is the document itself when that is all
    there is, and only the caller knows which.
    """
    role_for = {".pdf": "rendered_pdf_file", ".html": "raw_file", ".htm": "raw_file"}
    groups: dict[tuple[str, bool], list[str]] = {}
    for blocker in blockers:
        subject = str(blocker.get("subject") or "")
        # Only the slot conflicts are answerable with different flags. A missing
        # file or a path outside the repository needs the user to do something,
        # and offering a command that cannot work is worse than offering none.
        if not subject or blocker.get("code") not in ("slot_occupied", "ambiguous_slot"):
            continue
        chosen = role or role_for.get(Path(subject).suffix.lower(), "")
        if not chosen:
            continue
        overwrite = blocker.get("code") == "slot_occupied"
        groups.setdefault((chosen, overwrite), []).append(subject)

    remedies = []
    for (chosen, overwrite), paths in sorted(groups.items()):
        quoted = " ".join(shlex.quote(p) for p in sorted(set(paths)))
        remedies.append(
            f"ra attach {quoted}"
            + (f" --source-id {source_id}" if source_id else "")
            + f" --role {chosen}"
            + (" --overwrite" if overwrite else "")
            + " --apply"
        )
    return remedies


def cmd_attach(args, token):
    check_contract(token)
    hints = []
    for path in args.paths:
        hint = {"path": str(Path(path).expanduser().resolve())}
        if args.role:
            hint["role"] = args.role
        if args.source_id:
            hint["source_id"] = args.source_id
        if args.overwrite:
            hint["overwrite"] = True
        hints.append(hint)
    body, _ = request(
        "POST", "/api/workflow/v1/attach", token=token,
        payload={
            "paths": [h["path"] for h in hints],
            "hints": hints,
            "scan_inbox": not args.paths,
            "apply": args.apply,
            "reconvert": not args.no_convert,
            "wait_seconds": 120,
        },
    )
    data = data_of(body, allow_error=True)
    blockers = (data.get("plan") or {}).get("blockers", [])
    remedies = _attach_remedies(blockers, role=args.role, source_id=args.source_id)
    problems = [
        {
            "code": b["code"],
            "message": b["message"],
            # The same command answers every blocker in its group, so point each
            # one at it rather than leaving the remedy blank.
            "remedy": next(
                (r for r in remedies if shlex.quote(str(b.get("subject") or "")) in r), ""
            ),
        }
        for b in blockers
    ]
    ok = not blockers
    if remedies:
        nxt = remedies
    elif ok and not args.apply:
        nxt = data.get("next") or ["ra attach --apply"]
    else:
        nxt = data.get("next") or []
    return ok, data.get("summary", ""), nxt, data, problems


def cmd_run_column(args, token):
    check_contract(token)
    body, _ = request(
        "POST", "/api/workflow/v1/runs/columns", token=token,
        payload={
            "column_id": args.column,
            "scope": args.scope,
            "source_ids": [i.strip() for i in (args.ids or "").split(",") if i.strip()],
            "confirm_overwrite": args.confirm_overwrite,
            "wait_seconds": 120 if args.wait else 0,
        },
    )
    raise_if_busy(body, token)
    data = data_of(body)
    if args.wait and not data.get("terminal") and data.get("run_id"):
        data = follow(data["run_id"], token) or data
    if data.get("confirmation_required"):
        entries = next_actions(data.get("next"))
        return False, data.get("summary", ""), data.get("next"), data, [
            {"code": "confirmation_required", "message": data.get("summary", ""),
             "remedy": entries[0]["command"] if entries else ""}
        ]

    lines = [data.get("summary", "")]
    # The rejected answers themselves, because the count alone does not say
    # whether the prompt is being misread or the model is merely near-missing
    # the spelling.
    for item in data.get("coercions", [])[:MAX_SHOWN_CHANGES]:
        lines.append(
            f"  {item.get('source_id', '')}  returned {item.get('returned', '')!r}"
            f" -> stored {item.get('stored', '')!r}"
        )
    return not data.get("failed_rows"), "\n".join(lines), data.get("next"), data, []


def cmd_remap(args, token):
    check_contract(token)
    pairs = []
    for item in args.pairs:
        if "=" not in item:
            raise Problem(
                f"Expected URL=NEW_ID or id:000012=NEW_ID, got {item!r}.",
                code="bad_pair",
                remedy="ra remap https://example.com/a=5 https://example.com/b=3 --apply",
                exit_code=EXIT_USAGE,
            )
        target, new_id = item.rsplit("=", 1)
        key = "source_id" if target.startswith("id:") else "url"
        pairs.append({key: target[3:] if key == "source_id" else target, "new_id": new_id.strip()})
    return _operation("remap", "remap_source_ids", {"pairs": pairs}, args.apply, token)


def cmd_watch(args, token):
    check_contract(token)
    body, _ = request(
        "GET", f"/api/workflow/v1/runs/{args.run_id}", token=token,
        params={"wait_seconds": 120 if args.wait else 0},
    )
    data = data_of(body)
    return True, data.get("summary", ""), data.get("next"), data, []


