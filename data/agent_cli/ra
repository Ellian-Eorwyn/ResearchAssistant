def build_parser() -> argparse.ArgumentParser:
    # Global flags go on a shared parent so they are accepted both before and
    # after the subcommand. `ra doctor --json-only` failing on argument order
    # is exactly the kind of trap this tool exists to remove.
    common = argparse.ArgumentParser(add_help=False)
    # SUPPRESS matters: without it the subparser's default would overwrite a
    # value the top-level parser already saw, so the flag would only work in
    # one of the two positions.
    common.add_argument(
        "--json-only",
        action="store_true",
        default=argparse.SUPPRESS,
        help="Print only the JSON envelope.",
    )

    parser = argparse.ArgumentParser(
        prog="ra",
        description="Drive a ResearchAssistant repository.",
        parents=[common],
    )
    subparsers = parser.add_subparsers(dest="command", required=True)

    class sub:  # noqa: N801 - a tiny shim so every subcommand inherits the flags
        @staticmethod
        def add_parser(name, **kwargs):
            return subparsers.add_parser(name, parents=[common], **kwargs)

    p = sub.add_parser("version", help="Show the CLI and server contract versions.")
    p.set_defaults(func=cmd_version)

    p = sub.add_parser("doctor", help="Check everything is ready before a long job.")
    p.add_argument("--refresh-capabilities", action="store_true")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("where", help="Where am I, and what should I do next?")
    p.set_defaults(func=cmd_where)

    p = sub.add_parser("plan-sheet", help="Read a planning spreadsheet.")
    p.add_argument("path")
    p.add_argument("--header-row", type=int, default=None, help="0-based, if detection is wrong.")
    p.add_argument("--prompts-row", type=int, default=None)
    p.add_argument("--no-prompts-row", action="store_true")
    p.add_argument("--repair-encoding", choices=["auto", "never", "force"], default="auto")
    p.set_defaults(func=cmd_plan_sheet)

    p = sub.add_parser("create-sources", help="Create sources from the parsed sheet.")
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=cmd_create_sources)

    p = sub.add_parser("create-columns", help="Create columns from the parsed sheet.")
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=cmd_create_columns)

    p = sub.add_parser("columns", help="List columns and how full they are.")
    p.set_defaults(func=cmd_columns)

    p = sub.add_parser(
        "set-constraints",
        help="Restrict columns to the answers their own prompts list.",
    )
    p.add_argument("--ids", default="", help="Comma-separated column ids; default is all.")
    p.add_argument("--overwrite", action="store_true", help="Replace constraints already set.")
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=cmd_set_constraints)

    p = sub.add_parser("fetch", help="Download sources.")
    p.add_argument("--scope", default="queued",
                   choices=["queued", "all", "import", "latest_import", "empty_only"])
    p.add_argument("--ids", default="", help="Comma-separated ids; overrides --scope.")
    p.add_argument("--phases", default="fetch,convert")
    p.add_argument("--force", action="store_true", help="Re-fetch sources that already succeeded.")
    p.add_argument("--limit", type=int, default=None)
    p.add_argument("--wait", action="store_true")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("convert", help="Rebuild text from already-fetched files.")
    p.add_argument("--ids", default="")
    p.add_argument("--force", action="store_true")
    p.add_argument("--wait", action="store_true")
    p.set_defaults(func=cmd_convert)

    p = sub.add_parser("triage", help="Group failures and say what to do about each.")
    p.add_argument("--phase", default="fetch")
    p.set_defaults(func=cmd_triage)

    p = sub.add_parser("retry", help="Re-run every failure worth retrying.")
    p.add_argument("--wait", action="store_true")
    p.set_defaults(func=cmd_retry)

    p = sub.add_parser("attach", help="Attach hand-downloaded documents, then rebuild their text.")
    p.add_argument("paths", nargs="*")
    p.add_argument("--role", default="", help="Artifact slot, for ambiguous file types.")
    p.add_argument("--source-id", default="")
    p.add_argument("--overwrite", action="store_true")
    p.add_argument("--apply", action="store_true")
    p.add_argument("--no-convert", action="store_true")
    p.set_defaults(func=cmd_attach)

    p = sub.add_parser("run-column", help="Run one column's prompt over the sources.")
    p.add_argument("column")
    p.add_argument("--scope", default="empty_only",
                   choices=["empty_only", "all", "filtered", "selected"])
    p.add_argument("--ids", default="", help="Comma-separated source ids, with --scope selected.")
    p.add_argument("--confirm-overwrite", action="store_true")
    p.add_argument("--wait", action="store_true")
    p.set_defaults(func=cmd_run_column)

    p = sub.add_parser("remap", help="Renumber sources: ra remap URL=NEW_ID [...] --apply")
    p.add_argument("pairs", nargs="+", metavar="URL=NEW_ID",
                   help="Use id:000012=5 for a source with no URL.")
    p.add_argument("--apply", action="store_true")
    p.set_defaults(func=cmd_remap)

    p = sub.add_parser("watch", help="Report on a running job.")
    p.add_argument("run_id")
    p.add_argument("--wait", action="store_true")
    p.set_defaults(func=cmd_watch)

    return parser


def main(argv=None) -> int:
    args = build_parser().parse_args(argv)
    token, _ = write_token(find_repo_root())
    try:
        ok, summary, nxt, data, problems = args.func(args, token)
    except Problem as problem:
        emit(
            args.command, ok=False, summary=str(problem),
            nxt=[problem.remedy] if problem.remedy else [],
            problems=[{"code": problem.code, "message": str(problem), "remedy": problem.remedy}],
            json_only=getattr(args, 'json_only', False),
        )
        return problem.exit_code
    except Exception as exc:  # pragma: no cover - last resort
        emit(
            args.command, ok=False, summary=f"{type(exc).__name__}: {exc}",
            problems=[{"code": "unexpected_error", "message": str(exc), "remedy": ""}],
            json_only=getattr(args, 'json_only', False),
        )
        return EXIT_PROBLEM

    emit(args.command, ok=ok, summary=summary, nxt=nxt, data=data, problems=problems,
         json_only=getattr(args, 'json_only', False))
    return EXIT_OK if ok else EXIT_PROBLEM


if __name__ == "__main__":
    sys.exit(main())
