#!/usr/bin/env python3
"""ra -- drive a ResearchAssistant repository from the shell.

Every command prints a short human summary, then `--- json ---`, then the same
answer as compact JSON. Both go to stdout because an agent harness captures
merged output.

Two properties matter more than anything else here:

* **Every command is safe to re-run.** Nothing is stored about where you are in
  a workflow, so `ra where` is always the truth and repeating a step is a no-op
  rather than a mistake.
* **Every response carries `next`.** A caller that remembers nothing about the
  previous step reads `next[0]` and is correct. Each entry says whether it may
  be run straight away (`gate: "go"`) or needs the user's answer first
  (`gate: "ask_user"`), so the checkpoint travels with the command rather than
  depending on the caller remembering a rule from a skill document.

Exit codes: 0 ok, 1 blockers or failures, 2 usage error, 3 contract mismatch,
4 server unreachable.

Standard library only, so this runs anywhere the repository does.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

# The client-side half of the gate, for entries a server built before this
# contract, or this file built itself. Mirrors `gate_for` in
# backend/workflow/models.py -- the server's answer wins when it sends one.
GATED = re.compile(
    r"--confirm-overwrite\b|--apply\b|\bra (fetch|retry|convert|run-column|set-constraints)\b"
)

# Bumped whenever a response shape this file reads changes. The server declares
# its own; a mismatch means one side is stale, and saying so beats misbehaving.
CLI_CONTRACT_VERSION = 2

# Declared so a test can assert these fields still exist on the server models.
# This is the check that would have caught a skill telling agents to report
# column counters that were never in the response.
RESPONSE_FIELDS: dict[str, tuple[str, ...]] = {
    "Preflight": ("ok", "ok_to_fetch", "ok_to_run_columns", "checks", "summary", "next"),
    "Orientation": (
        "total_sources",
        "sources_by_fetch_status",
        "failures_by_code",
        "columns",
        "active_job",
        "summary",
        "next_actions",
    ),
    "TriageReport": ("phase", "total_failed", "groups", "summary", "next"),
    "SheetPlan": ("sources", "columns", "skipped_columns", "anomalies", "layout", "summary"),
    "RunOutcome": (
        "run_id",
        "state",
        "terminal",
        "counts",
        "succeeded_rows",
        "failed_rows",
        "row_errors_truncated",
        "coerced_rows",
        "coercions",
        "confirmation_required",
        "summary",
        "next",
    ),
    # Every `next` entry has this shape. Declared so the contract test fails if
    # the gate is ever dropped from the response.
    "NextAction": ("command", "gate", "why"),
}

EXIT_OK, EXIT_PROBLEM, EXIT_USAGE, EXIT_CONTRACT, EXIT_UNREACHABLE = 0, 1, 2, 3, 4


# ---------------------------------------------------------------------------
# discovery
# ---------------------------------------------------------------------------


def find_repo_root(start: Path | None = None) -> Path | None:
    current = (start or Path.cwd()).resolve()
    for candidate in [current, *current.parents]:
        if (candidate / ".ra_repo").is_dir():
            return candidate
    return None


def base_url() -> str:
    explicit = os.environ.get("RA_BASE_URL", "").strip()
    if explicit:
        return explicit.rstrip("/")
    return f"http://127.0.0.1:{os.environ.get('RA_PORT', '7995').strip() or '7995'}"


def write_token(repo_root: Path | None) -> tuple[str, str]:
    """Return `(token, where_it_came_from)`. The token itself is never printed."""
    for name in ("RA_AGENT_WRITE_TOKEN", "RESEARCHASSISTANT_AGENT_WRITE_TOKEN"):
        value = os.environ.get(name, "").strip()
        if value:
            return value, f"env {name}"
    if repo_root:
        path = repo_root / ".ra_repo" / "agent_tokens.json"
        try:
            return json.loads(path.read_text(encoding="utf-8"))["write_token"], ".ra_repo"
        except Exception:
            pass
    return "", "not found"


# ---------------------------------------------------------------------------
# transport
# ---------------------------------------------------------------------------


class Problem(Exception):
    def __init__(self, message: str, *, code: str = "error", remedy: str = "", exit_code: int = EXIT_PROBLEM):
        super().__init__(message)
        self.code = code
        self.remedy = remedy
        self.exit_code = exit_code


def request(method: str, path: str, *, token: str, payload=None, params=None, timeout=300):
    url = base_url() + path
    if params:
        url += "?" + urllib.parse.urlencode({k: v for k, v in params.items() if v not in (None, "")})
    body = json.dumps(payload).encode() if payload is not None else None
    req = urllib.request.Request(url, data=body, method=method)
    req.add_header("Content-Type", "application/json")
    if token:
        req.add_header("Authorization", f"Bearer {token}")
    try:
        with urllib.request.urlopen(req, timeout=timeout) as response:
            return json.loads(response.read() or b"{}"), response.status
    except urllib.error.HTTPError as exc:
        try:
            return json.loads(exc.read() or b"{}"), exc.code
        except Exception:
            raise Problem(f"HTTP {exc.code} from {path}", code="http_error") from exc
    except urllib.error.URLError as exc:
        raise Problem(
            f"Could not reach the app at {base_url()}: {exc.reason}",
            code="server_unreachable",
            remedy="Start it with: .venv/bin/python run.py",
            exit_code=EXIT_UNREACHABLE,
        ) from exc


def check_contract(token: str) -> None:
    body, _ = request("GET", "/api/workflow/v1/version", token=token, timeout=15)
    server = int((body.get("data") or {}).get("contract_version") or 0)
    if server != CLI_CONTRACT_VERSION:
        raise Problem(
            f"This repository's ra speaks contract {CLI_CONTRACT_VERSION}; "
            f"the server speaks {server}.",
            code="contract_mismatch",
            remedy="Restart the ResearchAssistant server, then re-attach this repository.",
            exit_code=EXIT_CONTRACT,
        )


# How long `--wait` will keep following a run before handing back `ra watch`.
FOLLOW_BUDGET_SECONDS = 3600.0


def running_job_id(token: str) -> str:
    """The id of whatever is running, or "". Used to explain a rejection."""
    try:
        body, _ = request("GET", "/api/workflow/v1/orientation", token=token, timeout=30)
        job = (body.get("data") or {}).get("active_job") or {}
        return str(job.get("job_id") or "") if job.get("running") else ""
    except Exception:
        return ""


def raise_if_busy(body: dict, token: str) -> None:
    """Turn "a repository operation is already running" into a command.

    The server knows which job is running but the rejection does not say, so a
    caller is told only that it cannot proceed -- and the obvious response, try
    again, fails the same way.
    """
    if body.get("status") != "error":
        return
    error = body.get("error") or {}
    message = str(error.get("message") or "")
    if "already running" not in message.lower():
        return
    job = running_job_id(token)
    raise Problem(
        message,
        code=str(error.get("code") or "run_rejected"),
        remedy=f"ra watch {job} --wait" if job else "ra where",
    )


def follow(run_id: str, token: str, *, budget_seconds: float = FOLLOW_BUDGET_SECONDS) -> dict:
    """Keep watching until the run is finished.

    The server's own wait budget is bounded because it is holding an HTTP
    connection, so `--wait` used to come back mid-run and leave the caller to
    write a polling loop. Starting a column and seeing it through is the most
    common thing anyone does here; a caller that has to script it is a missing
    capability, not a caller error.
    """
    deadline = time.monotonic() + budget_seconds
    data: dict = {}
    while time.monotonic() < deadline:
        body, _ = request(
            "GET", f"/api/workflow/v1/runs/{run_id}", token=token, params={"wait_seconds": 120}
        )
        data = data_of(body)
        if data.get("terminal"):
            break
    return data


def data_of(body: dict, *, allow_error: bool = False) -> dict:
    if body.get("status") == "error" and not allow_error:
        error = body.get("error") or {}
        raise Problem(error.get("message") or "The request failed.", code=error.get("code") or "error")
    return body.get("data") or {}


# ---------------------------------------------------------------------------
# output
# ---------------------------------------------------------------------------


def next_actions(raw) -> list[dict]:
    """Normalise `next` into gated entries.

    A bare string is treated as needing the user's answer whenever it looks like
    it starts work. Being wrong in that direction only costs a question; being
    wrong the other way starts a fetch or several hundred model calls nobody
    agreed to.
    """
    entries: list[dict] = []
    for item in raw or []:
        if isinstance(item, dict):
            command = str(item.get("command") or "")
            gate = str(item.get("gate") or "")
            why = str(item.get("why") or "")
        else:
            command, gate, why = str(item), "", ""
        if not command:
            continue
        if gate not in ("go", "ask_user"):
            gate = "ask_user" if GATED.search(command) else "go"
        entries.append({"command": command, "gate": gate, "why": why})
    return entries


def emit(command: str, *, ok: bool, summary: str, nxt=None, data=None, problems=None, json_only=False) -> None:
    envelope = {
        "ok": ok,
        "command": command,
        "summary": summary,
        "next": next_actions(nxt),
        "data": data if data is not None else {},
        "problems": list(problems or []),
    }
    if not json_only:
        print(summary)
        for item in envelope["problems"]:
            print(f"  ! {item.get('code', '')}: {item.get('message', '')}")
            if item.get("remedy"):
                print(f"    -> {item['remedy']}")
        if envelope["next"]:
            print("\nNext:")
            for item in envelope["next"]:
                if item["gate"] == "ask_user":
                    print("  ASK THE USER FIRST — do not run this until they answer:")
                    print(f"      {item['command']}")
                    if item["why"]:
                        print(f"      ({item['why']})")
                else:
                    print(f"  {item['command']}")
        print("--- json ---")
    print(json.dumps(envelope, ensure_ascii=False))


